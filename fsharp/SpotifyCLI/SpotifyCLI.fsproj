<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>spotify-cli</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>FS0025</WarningsNotAsErrors>
    <FSharpCoreImplicitPackageVersion>9.0.300</FSharpCoreImplicitPackageVersion>
    <!-- Enable test coverage collection -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain/Errors.fs" />
    <Compile Include="Domain/Types.fs" />
    <Compile Include="Services/ConfigService.fs" />
    <Compile Include="Services/HttpService.fs" />
    <Compile Include="Services/CryptoService.fs" />
    <Compile Include="Services/BrowserService.fs" />
    <Compile Include="Services/CallbackServerService.fs" />
    <Compile Include="Services/OAuthService.fs" />
    <Compile Include="Services/AuthenticationWorkflow.fs" />
    <Compile Include="Services/CacheService.fs" />
    <Compile Include="Infrastructure/SpotifyApi.fs" />
    <Compile Include="Services/UserProfileService.fs" />
    <Compile Include="Services/PlaylistService.fs" />
    <Compile Include="CLI/Output.fs" />
    <Compile Include="CLI/Commands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.3.13" />
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.0.1" />
  </ItemGroup>

</Project>
