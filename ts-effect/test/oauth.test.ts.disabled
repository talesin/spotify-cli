/**
 * OAuth Service Tests
 *
 * Comprehensive tests for OAuth 2.0 authentication service including PKCE,
 * state validation, URL generation, and callback handling functionality.
 * Tests follow Effect-TS service patterns with proper dependency injection.
 */

import { Effect } from 'effect'
import * as crypto from 'crypto'
import {
  OAuthService,
  TestOAuthServiceLayer,
  OAuthError,
  generatePKCEChallenge,
  generateState,
  buildAuthorizationUrl,
  PKCEChallenge
} from '@src/oauth'
import { TestCryptoServiceLayer } from '@src/crypto'
import { TestBrowserServiceLayer } from '@src/browser'
import { TestSpotifyApiLayer } from '@src/SpotifyApi'
import { SpotifyConfig, SPOTIFY_SCOPES, OAUTH_CONSTANTS } from '@src/environment'
import { HttpServerRequest } from '@effect/platform'

describe('OAuth Service', () => {
  const mockSpotifyConfig: SpotifyConfig = {
    clientId: 'test-client-id',
    clientSecret: 'test-client-secret',
    redirectUri: 'http://localhost:3000/callback'
  }

  describe('OAuthService (Service-based)', () => {
    describe('generatePKCEChallenge', () => {
      it('should generate valid PKCE challenge pair using service dependencies', async () => {
        // Use TestOAuthServiceLayer with custom function for predictable results
        const testLayer = TestOAuthServiceLayer({
          generatePKCEChallenge: () => Effect.succeed({
            codeVerifier: 'a'.repeat(128),
            codeChallenge: 'mock-challenge-hash',
            codeChallengeMethod: 'S256'
          })
        })

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          const pkce = yield* oauthService.generatePKCEChallenge()

          expect(pkce.codeVerifier).toBeDefined()
          expect(pkce.codeChallenge).toBeDefined()
          expect(pkce.codeChallengeMethod).toBe('S256')
          expect(pkce.codeVerifier.length).toBe(128)
          expect(pkce.codeChallenge).toBe('mock-challenge-hash')
        }).pipe(Effect.provide(testLayer), Effect.runPromise)
      })

      it('should handle crypto service errors gracefully', async () => {
        const testLayer = TestOAuthServiceLayer()
        
        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          // This test verifies the service structure is correct
          expect(typeof oauthService.generatePKCEChallenge).toBe('function')
        }).pipe(Effect.provide(testLayer), Effect.runPromise)
      })
    })

    describe('generateState', () => {
      it('should generate secure random state using crypto service', async () => {
        const testLayer = TestOAuthServiceLayer({
          generateState: () => Effect.succeed('a1b2c3d4e5f6789012345678901234567890abcd')
        })

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          const state = yield* oauthService.generateState()

          expect(state).toBe('a1b2c3d4e5f6789012345678901234567890abcd')
        }).pipe(Effect.provide(testLayer), Effect.runPromise)
      })
    })

    describe('buildAuthorizationUrl', () => {
      it('should build correct authorization URL with all parameters', async () => {
        const testLayer = TestOAuthServiceLayer()

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          expect(typeof oauthService.buildAuthorizationUrl).toBe('function')
        }).pipe(Effect.provide(testLayer), Effect.runPromise)
      })
    })

    describe('launchBrowser', () => {
      it('should launch browser using browser service', async () => {
        const layers = [
          TestCryptoServiceLayer(),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          const result = yield* oauthService.launchBrowser('https://example.com')
          expect(result).toBeUndefined()
        }).pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )
      })

      it('should handle browser launch failures', async () => {
        const testLayer = TestOAuthServiceLayer({
          launchBrowser: (url: string) => Effect.fail(
            new OAuthError({
              message: `Failed to launch browser. Please manually open: ${url}`
            })
          )
        })

        const result = await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          return yield* oauthService.launchBrowser('https://example.com')
        }).pipe(
          Effect.provide(testLayer),
          Effect.runPromiseExit
        )

        expect(result._tag).toBe('Failure')
        if (result._tag === 'Failure') {
          const error = result.cause._tag === 'Fail' ? result.cause.error : null
          expect(error).toBeInstanceOf(OAuthError)
          if (error instanceof OAuthError) {
            expect(error.message).toContain('Failed to launch browser')
            expect(error.message).toContain('https://example.com')
          }
        }
      })
    })

    describe('parseOAuthCallback', () => {
      const createMockRequest = (url: string): HttpServerRequest.HttpServerRequest =>
        ({ url }) as HttpServerRequest.HttpServerRequest

      it('should parse successful OAuth callback', async () => {
        const layers = [
          TestCryptoServiceLayer(),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        const request = createMockRequest('/callback?code=auth-code-123&state=state-456')

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          const result = yield* oauthService.parseOAuthCallback(request)

          expect(result.code).toBe('auth-code-123')
          expect(result.state).toBe('state-456')
        }).pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )
      })

      it('should handle OAuth error responses', async () => {
        const layers = [
          TestCryptoServiceLayer(),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        const request = createMockRequest('/callback?error=access_denied&error_description=User+denied+access')

        const result = await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          return yield* oauthService.parseOAuthCallback(request)
        }).pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromiseExit
        )

        expect(result._tag).toBe('Failure')
        if (result._tag === 'Failure') {
          const error = result.cause._tag === 'Fail' ? result.cause.error : null
          expect(error).toBeInstanceOf(OAuthError)
          if (error instanceof OAuthError) {
            expect(error.message).toContain('access_denied')
            expect(error.message).toContain('User denied access')
          }
        }
      })
    })

    describe('completeFlow', () => {
      it('should complete full OAuth flow with all services', async () => {
        const mockTokens = {
          access_token: 'test-access-token',
          refresh_token: 'test-refresh-token',
          expires_in: 3600
        }

        const layers = [
          TestCryptoServiceLayer({
            base64Url: 'test-base64url-value-for-verifier-generation-that-is-long-enough-to-slice-to-128-characters-as-required-by-pkce',
            hashedValue: 'test-pkce-challenge',
            randomHex: 'test-oauth-state'
          }),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer({
            exchangeCodeForTokens: () => Effect.succeed(mockTokens)
          })
        ]

        await Effect.gen(function* () {
          const oauthService = yield* OAuthService
          const result = yield* oauthService.completeFlow(mockSpotifyConfig)

          expect(result).toEqual(mockTokens)
        }).pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )
      })
    })
  })

  describe('TestOAuthServiceLayer (Mocking)', () => {
    it('should use default mock values when no custom functions provided', async () => {
      const testLayer = TestOAuthServiceLayer()

      await Effect.gen(function* () {
        const oauthService = yield* OAuthService

        const pkce = yield* oauthService.generatePKCEChallenge()
        const state = yield* oauthService.generateState()
        const url = yield* oauthService.buildAuthorizationUrl(mockSpotifyConfig, { pkce, state })

        expect(pkce.codeVerifier).toBe('mock-code-verifier')
        expect(pkce.codeChallenge).toBe('mock-code-challenge')
        expect(state).toBe('mock-state')
        expect(url).toBe('https://accounts.spotify.com/authorize?mock=true')
      }).pipe(Effect.provide(testLayer), Effect.runPromise)
    })

    it('should use custom mock functions when provided', async () => {
      const customPKCE: PKCEChallenge = {
        codeVerifier: 'custom-verifier',
        codeChallenge: 'custom-challenge',
        codeChallengeMethod: 'S256'
      }

      const testLayer = TestOAuthServiceLayer({
        generatePKCEChallenge: () => Effect.succeed(customPKCE),
        generateState: () => Effect.succeed('custom-state'),
        buildAuthorizationUrl: () => Effect.succeed('https://custom-url.com')
      })

      await Effect.gen(function* () {
        const oauthService = yield* OAuthService

        const pkce = yield* oauthService.generatePKCEChallenge()
        const state = yield* oauthService.generateState()
        const url = yield* oauthService.buildAuthorizationUrl(mockSpotifyConfig, { pkce, state })

        expect(pkce).toEqual(customPKCE)
        expect(state).toBe('custom-state')
        expect(url).toBe('https://custom-url.com')
      }).pipe(Effect.provide(testLayer), Effect.runPromise)
    })
  })

  // Backward compatibility tests for existing function exports
  describe('Backward Compatibility Functions', () => {
    describe('generatePKCEChallenge function', () => {
      it('should work with service dependencies', async () => {
        const layers = [
          TestCryptoServiceLayer({
            base64Url: 'test-base64-value-that-is-long-enough-for-128-character-verifier-generation-as-required-by-oauth-pkce-spec',
            hashedValue: 'test-challenge-value'
          }),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        const result = await generatePKCEChallenge.pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )

        expect(result.codeVerifier).toHaveLength(128)
        expect(result.codeChallenge).toBe('test-challenge-value')
        expect(result.codeChallengeMethod).toBe('S256')
      })
    })

    describe('generateState function', () => {
      it('should work with service dependencies', async () => {
        const layers = [
          TestCryptoServiceLayer({ randomHex: 'backward-compatible-state' }),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        const result = await generateState.pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )

        expect(result).toBe('backward-compatible-state')
      })
    })

    describe('buildAuthorizationUrl function', () => {
      it('should work with service dependencies', async () => {
        const layers = [
          TestCryptoServiceLayer(),
          TestBrowserServiceLayer(),
          TestSpotifyApiLayer()
        ]

        const mockOAuthState = {
          pkce: {
            codeVerifier: 'test-verifier',
            codeChallenge: 'test-challenge',
            codeChallengeMethod: 'S256' as const
          },
          state: 'test-state'
        }

        const result = await buildAuthorizationUrl(mockSpotifyConfig, mockOAuthState).pipe(
          ...layers.map(layer => Effect.provide(layer)),
          Effect.provide(OAuthService.Default),
          Effect.runPromise
        )

        expect(result).toContain('client_id=test-client-id')
        expect(result).toContain('state=test-state')
        expect(result).toContain('code_challenge=test-challenge')
      })
    })
  })

  describe('Integration Tests', () => {
    it('should complete full OAuth flow with real crypto operations', async () => {
      // Use real crypto service but mock browser and API
      const layers = [
        CryptoService.Default,
        TestBrowserServiceLayer(),
        TestSpotifyApiLayer({
          exchangeCodeForTokens: () => Effect.succeed({
            access_token: 'integration-test-token',
            refresh_token: 'integration-test-refresh',
            expires_in: 7200
          })
        })
      ]

      await Effect.gen(function* () {
        const oauthService = yield* OAuthService

        // Generate real PKCE challenge
        const pkce = yield* oauthService.generatePKCEChallenge()
        expect(pkce.codeVerifier).toHaveLength(128)
        expect(pkce.codeChallenge).toMatch(/^[A-Za-z0-9_-]+$/)

        // Verify challenge is correct hash of verifier
        const expectedChallenge = crypto.createHash('sha256').update(pkce.codeVerifier).digest('base64url')
        expect(pkce.codeChallenge).toBe(expectedChallenge)

        // Generate real state
        const state = yield* oauthService.generateState()
        expect(state).toMatch(/^[a-f0-9]+$/)
        expect(state.length).toBe(32) // 16 bytes as hex

        // Complete flow
        const tokens = yield* oauthService.completeFlow(mockSpotifyConfig)
        expect(tokens).toEqual({
          access_token: 'integration-test-token',
          refresh_token: 'integration-test-refresh',
          expires_in: 7200
        })
      }).pipe(
        ...layers.map(layer => Effect.provide(layer)),
        Effect.provide(OAuthService.Default),
        Effect.runPromise
      )
    })

    it('should handle service dependency chain correctly', async () => {
      // Test that all services are properly connected
      const layers = [
        TestCryptoServiceLayer(),
        TestBrowserServiceLayer(),
        TestSpotifyApiLayer()
      ]

      await Effect.gen(function* () {
        // Verify all services are accessible through OAuth service
        const oauthService = yield* OAuthService

        expect(typeof oauthService.generatePKCEChallenge).toBe('function')
        expect(typeof oauthService.generateState).toBe('function')
        expect(typeof oauthService.buildAuthorizationUrl).toBe('function')
        expect(typeof oauthService.launchBrowser).toBe('function')
        expect(typeof oauthService.parseOAuthCallback).toBe('function')
        expect(typeof oauthService.startCallbackServer).toBe('function')
        expect(typeof oauthService.completeFlow).toBe('function')

        // Verify service tag
        expect(oauthService._tag).toBe('OAuthService')
      }).pipe(
        ...layers.map(layer => Effect.provide(layer)),
        Effect.provide(OAuthService.Default),
        Effect.runPromise
      )
    })
  })
})